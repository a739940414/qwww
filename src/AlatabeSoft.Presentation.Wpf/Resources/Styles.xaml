<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DashboardCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Background" Value="#22FFFFFF" />
    </Style>

    <Style x:Key="DashboardCardHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="DashboardCardValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <Style x:Key="PanelCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="#22FFFFFF" />
        <Setter Property="BorderBrush" Value="#11FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PanelHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>
