<Application x:Class="AlatabeSoft.Presentation.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:AlatabeSoft.Presentation.Wpf.ViewModels"
             xmlns:views="clr-namespace:AlatabeSoft.Presentation.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AccountsViewModel}">
                <views:AccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CustomersViewModel}">
                <views:CustomersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CashReceiptViewModel}">
                <views:CashReceiptView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CashPaymentViewModel}">
                <views:CashPaymentView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
