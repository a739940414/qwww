<UserControl x:Class="AlatabeSoft.Presentation.Wpf.Views.CashPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="600">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="سندات الصرف"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,16" />

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="رقم السند" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="تاريخ السند" Margin="0,0,0,6" />
                <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding PaymentDate}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="الصندوق" Margin="0,16,0,6" />
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="حساب المصروف" Margin="0,16,0,6" />
                <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ExpenseAccounts}" SelectedItem="{Binding SelectedExpenseAccount}" DisplayMemberPath="DisplayName" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="المبلغ" Margin="0,16,0,6" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="سعر الصرف" Margin="0,16,0,6" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ExchangeRate, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="البيان" Margin="0,16,0,6" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True" Height="60" />
            </Grid>

            <Button Content="حفظ سند الصرف"
                    Width="180"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Command="{Binding SavePaymentCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Payments}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0,20,0,0"
                  FlowDirection="RightToLeft">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم" Binding="{Binding ReferenceNumber}" Width="*" />
                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}" Width="*" />
                <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBoxName}" Width="*" />
                <DataGridTextColumn Header="الحساب" Binding="{Binding ExpenseAccountName}" Width="*" />
                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
