<Window x:Class="AlatabeSoft.Presentation.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AlatabeSoft.Presentation.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="Alatabe Soft"
        WindowStartupLocation="CenterScreen"
        Width="1200"
        Height="720"
        FlowDirection="RightToLeft"
        FontFamily="Cairo"
        Background="{DynamicResource ApplicationBackground}">
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Container"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                Padding="16"
                                Margin="8"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="18" />
                                <ContentPresenter Margin="10,0,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Container" Property="Border.Background" Value="#44FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Border.Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource HeaderBackground}"
                Height="60"
                Padding="20,0"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="📊 Alatabe Soft - النظام المحاسبي المتكامل"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                    <TextBlock Text="الفرع:" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedBranch}" Margin="6,0,0,0" />
                    <TextBlock Text="|" Margin="12,0" />
                    <TextBlock Text="المستخدم:" FontWeight="SemiBold" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding CurrentUser}" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource NavigationBackground}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding NavigationItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                            <ToggleButton Style="{StaticResource NavigationButtonStyle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Command="{Binding SelectCommand}"
                                          Tag="{Binding Icon}">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Grid.Column="1" Margin="24"
                    Background="#11FFFFFF"
                    CornerRadius="20"
                    Padding="24">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
